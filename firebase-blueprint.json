{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vibebazar.com/schema/v1/database-blueprint.json",
  "title": "Vibebazar Firestore Database Blueprint",
  "description": "Production-grade JSON Schema definitions and Firestore path hierarchy for the Vibebazar e-commerce platform.",
  "entities": {
    "Product": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "$id": "#Product",
      "title": "Product",
      "description": "A Vibebazar product in the fashion or tech accessories catalog.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "category",
        "price",
        "stock",
        "images",
        "isCODEnabled",
        "codAllowedAreas",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique product slug used as the Firestore document key.",
          "pattern": "^[a-zA-Z0-9_\\-\\.]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Display name of the product.",
          "minLength": 1,
          "maxLength": 150
        },
        "category": {
          "type": "string",
          "description": "Category slug reference matching a document key in the /categories collection.",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "description": "Full product description (markdown supported).",
          "maxLength": 10000
        },
        "price": {
          "type": "number",
          "description": "Retail price in Bangladeshi Taka (BDT). Must be a non-negative value.",
          "minimum": 0,
          "maximum": 1000000,
          "multipleOf": 0.01
        },
        "stock": {
          "type": "integer",
          "description": "Current inventory count. 0 means out-of-stock.",
          "minimum": 0,
          "maximum": 100000
        },
        "images": {
          "type": "array",
          "description": "Ordered list of product image URLs for the gallery carousel.",
          "items": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          "minItems": 0,
          "maxItems": 10,
          "uniqueItems": false
        },
        "isCODEnabled": {
          "type": "boolean",
          "description": "Whether Cash-on-Delivery is permitted for this product."
        },
        "codAllowedAreas": {
          "type": "string",
          "description": "Geographic scope for COD eligibility.",
          "enum": ["all", "dhaka", "none"],
          "maxLength": 100
        },
        "isFeatured": {
          "type": "boolean",
          "description": "When true, the product is promoted on the home page hero section."
        },
        "createdAt": {
          "type": "string",
          "description": "ISO 8601 creation timestamp (UTC). Immutable after initial write.",
          "format": "date-time",
          "minLength": 15,
          "maxLength": 40
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO 8601 last-modified timestamp (UTC). Must be updated on every write.",
          "format": "date-time",
          "minLength": 15,
          "maxLength": 40
        }
      }
    },

    "Category": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "$id": "#Category",
      "title": "Category",
      "description": "A dynamic product category surfaced in navigation and filter UIs.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "createdAt"],
      "properties": {
        "id": {
          "type": "string",
          "description": "URL-safe slug used as the Firestore document key.",
          "pattern": "^[a-zA-Z0-9_\\-\\.]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Human-readable category label shown in the UI.",
          "minLength": 1,
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "description": "ISO 8601 creation timestamp (UTC). Immutable.",
          "format": "date-time",
          "minLength": 15,
          "maxLength": 40
        }
      }
    },

    "OrderItem": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "$id": "#OrderItem",
      "title": "OrderItem",
      "description": "A line-item snapshot within an Order. Prices are frozen at order time.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "price", "quantity"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Product document ID at order time.",
          "pattern": "^[a-zA-Z0-9_\\-\\.]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Product name snapshot at order time.",
          "minLength": 1,
          "maxLength": 150
        },
        "price": {
          "type": "number",
          "description": "Unit price in BDT at order time.",
          "minimum": 0,
          "maximum": 1000000
        },
        "quantity": {
          "type": "integer",
          "description": "Number of units ordered.",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },

    "Order": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "$id": "#Order",
      "title": "Order",
      "description": "A customer purchase receipt. Orders are guest-writable at creation only.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "customerName",
        "customerPhone",
        "customerAddress",
        "items",
        "paymentMethod",
        "paymentStatus",
        "status",
        "totalAmount",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique order reference in VIBE-XXXXXX format.",
          "pattern": "^VIBE-[A-Z0-9]{6}$",
          "minLength": 11,
          "maxLength": 128
        },
        "customerName": {
          "type": "string",
          "description": "Full name of the purchasing customer.",
          "minLength": 1,
          "maxLength": 200
        },
        "customerPhone": {
          "type": "string",
          "description": "Bangladeshi mobile number. Accepts 01XXXXXXXXX (11 digits) or international +880 variant (up to 15 digits).",
          "pattern": "^(\\+?880|0)[1-9][0-9]{9,12}$",
          "minLength": 11,
          "maxLength": 15
        },
        "customerAddress": {
          "type": "string",
          "description": "Full delivery shipping address.",
          "minLength": 1,
          "maxLength": 1000
        },
        "items": {
          "type": "array",
          "description": "Ordered line items. Each entry is a price-locked product snapshot.",
          "items": { "$ref": "#OrderItem" },
          "minItems": 1,
          "maxItems": 50
        },
        "paymentMethod": {
          "type": "string",
          "description": "Payment channel used for this order.",
          "enum": ["bKash", "Nagad", "Rocket", "COD"]
        },
        "paymentStatus": {
          "type": "string",
          "description": "Current payment verification state. Defaults to 'Pending' on creation.",
          "enum": ["Pending", "Confirmed"]
        },
        "transactionId": {
          "type": "string",
          "description": "Mobile banking transaction reference (bKash/Nagad/Rocket TrxID).",
          "maxLength": 100
        },
        "status": {
          "type": "string",
          "description": "Order fulfillment lifecycle state. Defaults to 'pending' on creation.",
          "enum": ["pending", "confirmed", "delivered", "cancelled"]
        },
        "totalAmount": {
          "type": "number",
          "description": "Grand total paid in BDT after discounts.",
          "minimum": 0,
          "maximum": 5000000
        },
        "discountCode": {
          "type": "string",
          "description": "Promo coupon code applied at checkout (optional).",
          "maxLength": 50
        },
        "discountAmount": {
          "type": "number",
          "description": "BDT amount deducted from subtotal (optional).",
          "minimum": 0
        },
        "createdAt": {
          "type": "string",
          "description": "ISO 8601 creation timestamp (UTC). Immutable after initial write.",
          "format": "date-time",
          "minLength": 15,
          "maxLength": 40
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO 8601 last-modified timestamp (UTC). Must advance on every admin update.",
          "format": "date-time",
          "minLength": 15,
          "maxLength": 40
        }
      }
    },

    "Coupon": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "$id": "#Coupon",
      "title": "Coupon",
      "description": "A promotional discount code redeemable at checkout.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "discountType",
        "discountValue",
        "minOrderAmount",
        "isActive",
        "createdAt"
      ],
      "properties": {
        "code": {
          "type": "string",
          "description": "Promo code key (uppercase alphanumeric, used as the Firestore document ID).",
          "pattern": "^[A-Z0-9]+$",
          "minLength": 1,
          "maxLength": 30
        },
        "discountType": {
          "type": "string",
          "description": "Whether the discount is a percentage of the subtotal or a flat BDT deduction.",
          "enum": ["percentage", "flat"]
        },
        "discountValue": {
          "type": "number",
          "description": "Discount magnitude. Percentage capped at 100; flat values are in BDT.",
          "minimum": 0,
          "maximum": 100000
        },
        "minOrderAmount": {
          "type": "number",
          "description": "Minimum order subtotal in BDT required to unlock this coupon.",
          "minimum": 0,
          "maximum": 1000000
        },
        "isActive": {
          "type": "boolean",
          "description": "If false, the coupon is disabled and must be rejected at checkout."
        },
        "createdAt": {
          "type": "string",
          "description": "ISO 8601 creation timestamp (UTC). Immutable.",
          "format": "date-time",
          "minLength": 15,
          "maxLength": 40
        }
      }
    },

    "Admin": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "$id": "#Admin",
      "title": "Admin",
      "description": "Whitelisted administrator. The document ID is the email address itself.",
      "type": "object",
      "additionalProperties": false,
      "required": ["email", "createdAt"],
      "properties": {
        "email": {
          "type": "string",
          "description": "Authorized Google/Firebase email address used as the document key.",
          "format": "email",
          "maxLength": 256
        },
        "createdAt": {
          "type": "string",
          "description": "ISO 8601 timestamp of when this admin was whitelisted.",
          "format": "date-time",
          "minLength": 15,
          "maxLength": 40
        }
      }
    },

    "Settings": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "$id": "#Settings",
      "title": "Settings",
      "description": "Global site configuration. Singleton document at /settings/main.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "paymentNumbers", "whatsappNumber", "updatedAt"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Must always be 'main' (singleton document guard).",
          "enum": ["main"]
        },
        "paymentNumbers": {
          "type": "object",
          "description": "Official merchant mobile numbers for each supported payment gateway.",
          "additionalProperties": false,
          "required": ["bKash", "Nagad"],
          "properties": {
            "bKash": {
              "type": "string",
              "description": "Official bKash merchant number.",
              "minLength": 11,
              "maxLength": 15
            },
            "Nagad": {
              "type": "string",
              "description": "Official Nagad merchant number.",
              "minLength": 11,
              "maxLength": 15
            },
            "Rocket": {
              "type": "string",
              "description": "Official Rocket merchant number (optional).",
              "minLength": 11,
              "maxLength": 15
            }
          }
        },
        "whatsappNumber": {
          "type": "string",
          "description": "WhatsApp contact number in international format (e.g. 8801XXXXXXXXX).",
          "minLength": 10,
          "maxLength": 20
        },
        "facebookPixelId": {
          "type": "string",
          "description": "Meta/Facebook Pixel tracking ID for conversion analytics.",
          "maxLength": 50
        },
        "messengerChatUrl": {
          "type": "string",
          "description": "Facebook Messenger chat plugin URL for the live chat widget.",
          "format": "uri",
          "maxLength": 512
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO 8601 last-modified timestamp (UTC).",
          "format": "date-time",
          "minLength": 15,
          "maxLength": 40
        }
      }
    }
  },

  "firestore": {
    "products/{id}": {
      "schema": "#Product",
      "description": "Vibebazar fashion and tech accessories catalog. Publicly readable; admin-only writes.",
      "access": {
        "read": "public",
        "write": "admin"
      },
      "indexes": [
        { "fields": ["category", "isFeatured"], "order": "ASC" },
        { "fields": ["category", "price"], "order": "ASC" },
        { "fields": ["isFeatured", "createdAt"], "order": "DESC" }
      ]
    },
    "categories/{id}": {
      "schema": "#Category",
      "description": "Dynamic product taxonomy surfaced in nav and filter UI. Publicly readable; admin-only writes.",
      "access": {
        "read": "public",
        "write": "admin"
      }
    },
    "orders/{id}": {
      "schema": "#Order",
      "description": "Customer purchase receipts. Guest-writable at creation (enforced 'pending' initial state). List requires admin. Single-document get is public (for order tracking).",
      "access": {
        "list": "admin",
        "get": "public",
        "create": "public (enforced invariants)",
        "update": "admin",
        "delete": "admin"
      },
      "indexes": [
        { "fields": ["status", "createdAt"], "order": "DESC" },
        { "fields": ["customerPhone", "createdAt"], "order": "DESC" }
      ]
    },
    "coupons/{code}": {
      "schema": "#Coupon",
      "description": "Promotional discount codes. Publicly readable for checkout validation; admin-only writes.",
      "access": {
        "read": "public",
        "write": "admin"
      }
    },
    "admins/{email}": {
      "schema": "#Admin",
      "description": "Admin whitelist map. Document ID is the email. Write access restricted to existing admins only.",
      "access": {
        "read": "public",
        "write": "admin"
      }
    },
    "settings/{id}": {
      "schema": "#Settings",
      "description": "Global site configuration singleton at /settings/main. Publicly readable; admin-only writes; deletion blocked.",
      "access": {
        "read": "public",
        "create": "admin",
        "update": "admin",
        "delete": "blocked"
      }
    }
  }
}
